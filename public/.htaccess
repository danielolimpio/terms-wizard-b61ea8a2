# Force text/plain for ads.txt
<IfModule mod_mime.c>
  AddType text/plain .txt
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ===== IMPORTANTE: Servir arquivos estáticos ANTES de redirecionar para SPA =====
  
  # 1. Arquivos de verificação e SEO (Google, Bing, Yandex, etc.)
  RewriteRule ^(google[a-z0-9]+\.html|BingSiteAuth\.xml|yandex_[a-z0-9]+\.html)$ - [L]
  
  # 2. Arquivos essenciais de SEO e monetização
  RewriteRule ^(ads\.txt|robots\.txt|sitemap\.xml|sitemap_index\.xml)$ - [L]
  
  # 3. Ícones e imagens da raiz
  RewriteRule ^(favicon\.ico|apple-touch-icon.*\.png|og-image\.(jpg|png|webp)|android-chrome.*\.png|mstile.*\.png)$ - [L]
  
  # 4. Manifests e arquivos de configuração do navegador
  RewriteRule ^(manifest\.json|browserconfig\.xml|site\.webmanifest)$ - [L]
  
  # 5. Diretório .well-known (SSL, Apple Pay, etc.)
  RewriteRule ^\.well-known/ - [L]
  
  # 6. Extensões de arquivos estáticos comuns (imagens, fontes, docs, etc.)
  RewriteRule \.(txt|xml|json|ico|png|jpg|jpeg|gif|webp|svg|woff|woff2|ttf|eot|otf|pdf|zip|css|js|map)$ - [L]
  
  # 7. Não redirecionar arquivos ou diretórios reais (fallback)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 8. APENAS AGORA: Redirecionar todas as demais rotas para index.html (SPA)
  RewriteRule ^ index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpg "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType application/pdf "access plus 1 month"
ExpiresByType text/x-javascript "access plus 1 month"
</IfModule>
